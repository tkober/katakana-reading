# Postgres connection. DB_URL carries only host/port/database — credentials are
# supplied per role below, and the async driver is added by app/config.py.
# The katakana database and the katakana_app / katakana_owner roles must already
# exist (see dbeaver/create_users_and_db.sql + dbeaver/grant_privileges.sql).
DB_URL=postgresql://localhost:5432/katakana

# App role: everything a request does (CRUD only, no DDL).
DB_USER=katakana_app
DB_PASSWORD=

# Owner role: used at startup to create the tables and refresh the vocabulary.
DB_OWNER_USER=katakana_owner
DB_OWNER_PASSWORD=

# Browser origins allowed to call this service directly, comma-separated. Only
# relevant for direct calls: in the deployment nginx proxies /api same-origin,
# so no CORS check happens there. Defaults to the Angular dev server.
CORS_ORIGINS=http://localhost:4200

# Where the JSON vocabulary lives (defaults to <repo>/words).
# WORDS_DIR=../words
